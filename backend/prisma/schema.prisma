// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        Int     @id @default(autoincrement())
  name      String
  email     String  @unique
  password  String
  createdAt DateTime @default(now())
  role      Role @default(CLIENT)
  clientProfile Clientprofile?
  notes UserNote[]
  requests       Request[]
}

enum Role {
  CLIENT
  ADMIN
} 

model Clientprofile{
  id        Int     @id @default(autoincrement())
  userId    Int     @unique
  Phone     String
  company   String
  status    Status @default(Active)
  createdAt DateTime @default(now())

  user      User    @relation(fields: [userId], references: [id])
}

enum Status{
  Active
  Inactive
}

model UserNote{
  id        Int     @id @default(autoincrement())
  userId    Int     
  title     String
  content   String
  createdAt DateTime @default(now())
  user      User    @relation(fields: [userId], references: [id])
}

model SupportUnit {
    id        Int      @id @default(autoincrement())
    name      String   @unique
    createdAt DateTime @default(now())

    requests  Request[]
}


model Request {
  id          Int      @id @default(autoincrement())
  userId      Int
  supportUnitId Int
  title       String
  description String
  status      RequestStatus @default(PENDING)
  priority    RequestPriority @default(MEDIUM)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id])
  supportUnit SupportUnit @relation(fields: [supportUnitId], references: [id])

}

enum RequestStatus {
  PENDING
  IN_PROGRESS
  RESOLVED
  REJECTED
}

enum RequestPriority {
  LOW
  MEDIUM
  HIGH
}
