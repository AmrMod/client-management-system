model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  role      Role     @default(STUDENT)
  createdAt DateTime @default(now())

  studentProfile StudentProfile?
  staffProfile   StaffProfile?
  notifications  Notification[]

}

enum Role {
  STUDENT
  STAFF
  ADMIN
}




