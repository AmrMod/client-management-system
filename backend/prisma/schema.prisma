//clientProfile is now StudentProfile and the split of the user table into two
model StudentProfile {
  id           Int      @id @default(autoincrement())
  userId       Int      @unique
  studentId    String   @unique
  name         String
  phone        String?
  department   String
  programme    String
  level        String
  createdAt    DateTime @default(now())

  user         User      @relation(fields: [userId], references: [id])
  requests     Request[]
  notes        StudentNote[]

}


model StaffProfile {
  id            Int       @id @default(autoincrement())
  userId        Int       @unique
  name          String
  phone         String?
  staffRole     StaffRole
  supportUnitId Int
  createdAt     DateTime  @default(now())

  user          User        @relation(fields: [userId], references: [id])
  supportUnit   SupportUnit @relation(fields: [supportUnitId], references: [id])
  requests      Request[]
  notes  StudentNote[]
}


enum StaffRole {
  MANAGER
  SUPPORT_STAFF
}



