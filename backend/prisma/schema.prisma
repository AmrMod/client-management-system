model StudentNote {
  id            Int      @id @default(autoincrement())
  studentId     Int
  createdById   Int
  title         String
  content       String
  createdAt     DateTime @default(now())

  student       StudentProfile @relation(fields: [studentId], references: [id])
  createdBy     StaffProfile   @relation(fields: [createdById], references: [id])
}




